{
  "name": "europe-historical-atlas",
  "version": "1.0.0",
  "description": "Interactive 3D historical atlas of Europe (TypeScript + three.js + Vite)",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @europe-historical-atlas/atlas dev",
    "dev:cartographer": "pnpm --filter @europe-historical-atlas/cartographer dev",
    "build": "turbo build",
    "preview": "pnpm --filter @europe-historical-atlas/atlas preview",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo test",
    "coverage": "turbo coverage && node scripts/merge-coverage.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "three.js",
    "typescript",
    "vite",
    "Historical Atlas",
    "Europe"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-eha": "workspace:*",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "pngjs": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:"
  }
}
