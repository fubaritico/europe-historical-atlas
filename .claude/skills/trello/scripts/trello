#!/usr/bin/env node
// The project's Trello board, one verb per gesture. Reads TRELLO_API_KEY and TRELLO_TOKEN from the
// repository's .env.local and never prints either. Any Trello refusal exits 1 with its status: no retry,
// no fallback.
import { readFileSync } from 'node:fs'
import { dirname, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'

/** The board this repository tracks its work on. */
const BOARD = '6ad371ed842063195c4ceb77'
/**
 * The columns, in board order — a card matures left to right. `done` moves a card to the last one.
 * `Chantiers` stands outside that flow: an initiative stays there its whole life (the dev's call, 2026-10-19).
 */
const COLUMNS = ['Chantiers', 'Idées', 'Backlog', 'À faire', 'En cours', 'À valider par le développeur', 'Fait']

/** The label a card waiting on another card carries; it keeps its column (the dev's call, 2026-10-17). */
const BLOCKED = { name: 'Bloqué', color: 'red' }

/** A card's importance, shown as the colour of its cover — the header (the dev's call, 2026-10-18). */
const PRIORITIES = { haute: 'red', moyenne: 'yellow', aucune: null }

/** Every label of the board, by family — the dev's call, 2026-10-17. `setup` creates the missing ones. */
const LABELS = [
  // severity — one at most, on a card that fixes a problem; the label is its only home
  { name: 'critique', color: 'red_dark' },
  { name: 'gênant', color: 'orange' },
  { name: 'cosmétique', color: 'yellow' },
  // scope
  { name: 'atlas', color: 'blue' },
  { name: 'Cartographe', color: 'purple' },
  { name: 'core', color: 'sky' },
  { name: 'données', color: 'green' },
  { name: 'outillage', color: 'black' },
  { name: 'CMS', color: 'blue_dark' },
  { name: 'design', color: 'red_light' },
  // type
  { name: "retour d'usage", color: 'pink' },
  { name: 'défaut', color: 'orange_dark' },
  { name: 'fonction', color: 'lime' },
  { name: 'dette', color: 'yellow_dark' },
  { name: 'décision', color: 'purple_light' },
  { name: 'doc', color: 'black_light' },
  // chantier — every ticket of an initiative carries its label, so one click filters the whole of it
  { name: 'chantier · incertitude', color: 'green_dark' },
  { name: 'chantier · cms', color: 'blue_light' },
  // status
  BLOCKED,
]

/** The card templates, one per maturity — the same text as SKILL.md's "The two templates". */
const TEMPLATES = [
  {
    column: 'Idées',
    name: 'Modèle — Idée',
    desc: "**Quoi** : <une ligne, dans tes mots>\n**D'où ça vient** : <toi / un test / une revue / l'appli> — <date>",
  },
  {
    column: 'Backlog',
    name: 'Modèle — Backlog',
    desc: [
      '**Le problème ou le besoin** : <ce qui gêne ou ce qu’on veut>',
      '**Le remède** : <ce qu’on fera, une ou deux phrases>',
      "**Critères d'acceptation** :",
      '- <un geste dans l’appli> → <ce qu’on voit>',
      '**Appli** : atlas | Cartographe | les deux | core',
      '**Dépend de** : <#N — pourquoi> (sinon : rien)',
      '**Détails** : <known-issues, plan, H-NN, scénario sNN, commit>',
    ].join('\n'),
  },
]

const ROOT =resolve(dirname(fileURLToPath(import.meta.url)), '../../../..')

/** Reads KEY=value lines from .env.local; leading spaces tolerated. */
function readEnv() {
  const env = {}
  for (const line of readFileSync(resolve(ROOT, '.env.local'), 'utf8').split('\n')) {
    const match = line.trim().match(/^([A-Z_]+)=(.*)$/)
    if (match) env[match[1]] = match[2].trim()
  }
  if (!env.TRELLO_API_KEY || !env.TRELLO_TOKEN) fail('.env.local lacks TRELLO_API_KEY or TRELLO_TOKEN')
  return env
}

function fail(message) {
  console.error(`[trello] ${message}`)
  process.exit(1)
}

const { TRELLO_API_KEY, TRELLO_TOKEN } = readEnv()

/** One call to the Trello REST API; params go in the query, the URL is never printed. */
async function api(method, path, params = {}, body = undefined) {
  const query = new URLSearchParams({ ...params, key: TRELLO_API_KEY, token: TRELLO_TOKEN })
  const init = body === undefined ? { method } : { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }
  const response = await fetch(`https://api.trello.com/1${path}?${query}`, init)
  if (!response.ok) fail(`${method} ${path} → ${response.status} ${await response.text()}`)
  return response.json()
}

async function lists() {
  return api('GET', `/boards/${BOARD}/lists`, { fields: 'name' })
}

async function listNamed(name) {
  const found = (await lists()).find((list) => list.name === name)
  if (!found) fail(`no column "${name}" — columns: ${COLUMNS.join(' / ')} (run setup)`)
  return found
}

const SCOPES = 'ATLAS|CARTO|CORE|CMS|REPO|DESIGN'
/**
 * Scopes no longer given but still read, so a card that kept one — an archived card is never renamed — counts in the
 * ticket counter and no number is given twice. `CONTRIB` became `CMS` on 2026-10-25 (the dev's call).
 */
const RETIRED_SCOPES = 'CONTRIB'
const READ_SCOPES = `${SCOPES}|${RETIRED_SCOPES}`
/** A title's ticket: `[CARTO-41 · ATLAS] title` → main scope, number (absent before numbering), second scope, bare title. */
const TICKET = new RegExp(`^\\[(${READ_SCOPES})(?:-(\\d+))?(?: · (${READ_SCOPES}))?\\]\\s*(.*)$`, 'is')

function parseTicket(title) {
  const m = title.match(TICKET)
  return m && { scope: m[1].toUpperCase(), number: m[2] && Number(m[2]), second: m[3]?.toUpperCase(), bare: m[4] }
}

/** `[CARTO-41 · ATLAS] title` — the number on the first scope, scopes in capitals (the dev's call). */
/** How a card is named in a comment: its ticket, or Trello's number for a card without one. */
function ticketRef(c) {
  const t = parseTicket(c.name)
  return t?.number ? `${t.scope}-${t.number}` : `#${c.idShort}`
}

function ticketTitle({ scope, number, second, bare }) {
  return `[${scope}-${number}${second ? ` · ${second}` : ''}] ${bare}`
}

/**
 * The next ticket number: one counter for the whole board, 1 to infinity, never reused — archived cards
 * count, so a number once given is never given again (the dev's call, 2026-10-17).
 */
async function nextTicket() {
  const all = await api('GET', `/boards/${BOARD}/cards/all`, { fields: 'name' })
  return Math.max(0, ...all.map((c) => parseTicket(c.name)?.number ?? 0)) + 1
}

/** A card named by its ticket (`CARTO-41`, the scope is not checked) or by Trello's own number (`41`). */
async function card(ref) {
  const fields = 'name,desc,idList,idShort,url'
  const ticket = (ref ?? '').match(new RegExp(`^(?:${READ_SCOPES})-(\\d+)$`, 'i'))
  if (ticket) {
    const open = await api('GET', `/boards/${BOARD}/cards`, { fields })
    const found = open.find((c) => parseTicket(c.name)?.number === Number(ticket[1]))
    if (!found) fail(`no open card has ticket ${ref}`)
    return found
  }
  if (!/^\d+$/.test(ref ?? '')) fail(`a card is named by its ticket (CARTO-41) or its Trello number, got "${ref}"`)
  return api('GET', `/boards/${BOARD}/cards/${ref}`, { fields })
}

/** The board's label of that name, created with its colour the first time it is asked for. */
async function label({ name, color }) {
  const found = (await api('GET', `/boards/${BOARD}/labels`, { fields: 'name' })).find((l) => l.name === name)
  if (found) return found
  console.warn(`label created: ${name}`)
  return api('POST', '/labels', { idBoard: BOARD, name, color })
}

const verbs = {
  /** Creates the missing columns, then puts every column in COLUMNS order. */
  async setup() {
    const existing = new Map((await lists()).map((list) => [list.name, list.id]))
    for (const [index, name] of COLUMNS.entries()) {
      const pos = String((index + 1) * 1024)
      const id = existing.get(name)
      if (id) {
        await api('PUT', `/lists/${id}`, { pos })
        continue
      }
      await api('POST', '/lists', { idBoard: BOARD, name, pos })
      console.warn(`column created: ${name}`)
    }
    for (const wanted of LABELS) await label(wanted)
    const existingCards = await api('GET', `/boards/${BOARD}/cards`, { fields: 'name' })
    for (const template of TEMPLATES) {
      const found = existingCards.find((c) => c.name === template.name)
      if (found) {
        await api('PUT', `/cards/${found.id}`, { desc: template.desc })
        continue
      }
      const list = await listNamed(template.column)
      await api('POST', '/cards', { idList: list.id, name: template.name, desc: template.desc, pos: 'top', isTemplate: 'true' })
      console.warn(`template created: ${template.name}`)
    }
  },
  /** Every column with its cards, as #number title. */
  async list() {
    const cards = await api('GET', `/boards/${BOARD}/cards`, { fields: 'name,idList,idShort,isTemplate,labels' })
    for (const list of await lists()) {
      console.warn(`\n${list.name}`)
      for (const c of cards.filter((c) => c.idList === list.id)) {
        const tags = [c.isTemplate ? 'modèle' : '', ...c.labels.map((l) => l.name)].filter(Boolean)
        console.warn(`  #${c.idShort} ${c.name}${tags.length ? ` [${tags.join(', ')}]` : ''}`)
      }
    }
  },
  /**
   * add <column> <title> [description] [label…] — labels checked against LABELS before anything is created. The
   * description travels in the request's body, never in its URL: CloudFront refuses a URL past ~8 kB (414, 2026-10-29).
   */
  async add(column, title, desc = '', ...names) {
    if (!title) fail('add <column> <title> [description] [label…]')
    const ticket = parseTicket(title)
    if (!ticket) fail(`a title starts with its scope: "[CARTO] …", "[ATLAS · CARTO] …" — got "${title}"`)
    if (new RegExp(`^(?:${RETIRED_SCOPES})$`).test(ticket.scope)) fail(`[${ticket.scope}] is retired — use one of ${SCOPES}`)
    if (ticket.number) fail(`the script gives the number — write "[${ticket.scope}] …", not "[${ticket.scope}-${ticket.number}] …"`)
    title = ticketTitle({ ...ticket, number: await nextTicket() })
    const unknown = names.filter((n) => !LABELS.some((l) => l.name === n))
    if (unknown.length) fail(`unknown label(s): ${unknown.join(', ')}`)
    const list = await listNamed(column)
    const ids = []
    for (const name of names) ids.push((await label(LABELS.find((l) => l.name === name))).id)
    const created = await api('POST', '/cards', { idList: list.id, name: title, pos: 'bottom', idLabels: ids.join(',') }, { desc })
    console.warn(`#${created.idShort} added to ${column}: ${title}${names.length ? ` [${names.join(', ')}]` : ''}`)
  },
  /** priority <number> haute|moyenne|aucune — the card's cover colour, its importance at a glance. */
  async priority(number, level) {
    if (!(level in PRIORITIES)) fail(`priority <number> ${Object.keys(PRIORITIES).join('|')}`)
    const c = await card(number)
    const color = PRIORITIES[level]
    await api('PUT', `/cards/${c.id}`, {}, { cover: color === null ? { color: null } : { color, size: 'normal' } })
    console.warn(`#${c.idShort} priority ${level}: ${c.name}`)
  },
  /**
   * edit <number> <description> — replaces the description: how an Idée is shaped into the Backlog template. The text
   * travels in the body, as `add`'s does.
   */
  async edit(number, desc) {
    if (desc === undefined) fail('edit <number> <description>')
    const c = await card(number)
    await api('PUT', `/cards/${c.id}`, {}, { desc })
    console.warn(`#${c.idShort} description replaced: ${c.name}`)
  },
  /** prefix <card> <scope> — changes a card's scope; its ticket number never changes (one is given if it has none). */
  async prefix(ref, scope) {
    const scopes = (scope ?? '').toUpperCase().split(' · ')
    if (!scopes.every((s) => new RegExp(`^(?:${SCOPES})$`).test(s)) || scopes.length > 2)
      fail(`prefix <card> <scope>  (${SCOPES.toLowerCase().split('|').join(', ')}; two joined by " · ")`)
    const c = await card(ref)
    // only a scope prefix is replaced — a title may legitimately start with a bracket ("[Save] …")
    const current = parseTicket(c.name)
    const name = ticketTitle({
      scope: scopes[0],
      second: scopes[1],
      number: current?.number ?? (await nextTicket()),
      bare: current ? current.bare : c.name,
    })
    await api('PUT', `/cards/${c.id}`, { name })
    console.warn(`#${c.idShort} ${name}`)
  },
  /** rename <number> <title> */
  async rename(number, title) {
    if (!title) fail('rename <number> <title>')
    const c = await card(number)
    await api('PUT', `/cards/${c.id}`, { name: title })
    console.warn(`#${c.idShort} renamed: ${c.name} → ${title}`)
  },
  /** above <card> <other card> — puts the card just above the other one, in the other one's column. */
  async above(ref, otherRef) {
    if (!otherRef) fail('above <card> <other card>')
    const [c, other] = [await card(ref), await card(otherRef)]
    const siblings = (await api('GET', `/lists/${other.idList}/cards`, { fields: 'pos' })).sort((a, b) => a.pos - b.pos)
    const at = siblings.findIndex((s) => s.id === other.id)
    const before = siblings.slice(0, at).filter((s) => s.id !== c.id).at(-1)
    const pos = before ? (before.pos + siblings[at].pos) / 2 : siblings[at].pos / 2
    await api('PUT', `/cards/${c.id}`, { idList: other.idList, pos: String(pos) })
    console.warn(`#${c.idShort} placed above #${other.idShort}: ${c.name}`)
  },
  /** move <number> <column> — to the bottom of the column, except Fait: newest first (the dev's call, 2026-10-18). */
  async move(number, column) {
    const target = await listNamed(column)
    const c = await card(number)
    const pos = column === COLUMNS[COLUMNS.length - 1] ? 'top' : 'bottom'
    await api('PUT', `/cards/${c.id}`, { idList: target.id, pos })
    console.warn(`#${c.idShort} → ${column}: ${c.name}`)
  },
  /** done <number> — moves the card to the top of the last column, Fait reading newest first. */
  async done(number) {
    await verbs.move(number, COLUMNS[COLUMNS.length - 1])
  },
  /** archive <number> <reason> — closes a card (undone from Trello's archive), the reason left as a comment. */
  async archive(number, reason) {
    if (!reason) fail('archive <number> <reason>')
    const c = await card(number)
    await api('POST', `/cards/${c.id}/actions/comments`, { text: `Archivée : ${reason}` })
    await api('PUT', `/cards/${c.id}`, { closed: 'true' })
    console.warn(`#${c.idShort} archived: ${c.name}`)
  },
  /** comment <number> <text> — the text travels in the body, as `add`'s description does. */
  async comment(number, text) {
    if (!text) fail('comment <number> <text>')
    const c = await card(number)
    await api('POST', `/cards/${c.id}/actions/comments`, {}, { text })
    console.warn(`#${c.idShort} commented: ${c.name}`)
  },
  /** block <number> <blocking number> <reason> — label, a link to the blocking card, a comment on both. */
  async block(number, blocking, reason) {
    if (!reason) fail('block <number> <blocking number> <reason>')
    if (number === blocking) fail('a card cannot depend on itself')
    const [c, by, blocked] = [await card(number), await card(blocking), await label(BLOCKED)]
    await api('POST', `/cards/${c.id}/idLabels`, { value: blocked.id })
    await api('POST', `/cards/${c.id}/attachments`, { url: by.url, name: `Dépend de ${ticketRef(by)}` })
    await api('POST', `/cards/${c.id}/actions/comments`, { text: `Bloqué par ${ticketRef(by)} — ${reason}` })
    await api('POST', `/cards/${by.id}/actions/comments`, { text: `Bloque ${ticketRef(c)} — ${reason}` })
    console.warn(`${ticketRef(c)} blocked by ${ticketRef(by)}: ${reason}`)
  },
  /** unblock <number> — removes the label and the links to other cards, says so in a comment. */
  async unblock(number) {
    const [c, blocked] = [await card(number), await label(BLOCKED)]
    const labels = (await api('GET', `/cards/${c.id}`, { fields: 'idLabels' })).idLabels
    if (!labels.includes(blocked.id)) fail(`#${c.idShort} is not blocked`)
    await api('DELETE', `/cards/${c.id}/idLabels/${blocked.id}`)
    const links = (await api('GET', `/cards/${c.id}/attachments`)).filter((a) => a.name?.startsWith('Dépend de '))
    for (const link of links) await api('DELETE', `/cards/${c.id}/attachments/${link.id}`)
    await api('POST', `/cards/${c.id}/actions/comments`, { text: 'Débloqué' })
    console.warn(`#${c.idShort} unblocked: ${c.name}`)
  },
  /** tag <number> <label>… — adds board labels to a card; an unknown label name is refused. */
  async tag(number, ...names) {
    if (names.length === 0) fail('tag <number> <label>…')
    const known = new Set(LABELS.map((l) => l.name))
    const unknown = names.filter((n) => !known.has(n))
    if (unknown.length) fail(`unknown label(s): ${unknown.join(', ')} — labels: ${[...known].join(', ')}`)
    const c = await card(number)
    for (const name of names) {
      const l = await label(LABELS.find((wanted) => wanted.name === name))
      await api('POST', `/cards/${c.id}/idLabels`, { value: l.id })
    }
    console.warn(`#${c.idShort} tagged ${names.join(', ')}: ${c.name}`)
  },
  /** relabel <old> <new> — renames a label on the board; every card that carries it keeps it, under its new name. */
  async relabel(from, to) {
    if (!from || !to) fail('relabel <old name> <new name>')
    const l = (await api('GET', `/boards/${BOARD}/labels`, { fields: 'name' })).find((x) => x.name === from)
    if (!l) fail(`no label "${from}" on the board`)
    await api('PUT', `/labels/${l.id}`, { name: to })
    console.warn(`label renamed: ${from} → ${to}`)
  },
  /** untag <number> <label> — removes one label from a card. */
  async untag(number, name) {
    const c = await card(number)
    const l = (await api('GET', `/boards/${BOARD}/labels`, { fields: 'name' })).find((x) => x.name === name)
    if (!l) fail(`no label "${name}" on the board`)
    await api('DELETE', `/cards/${c.id}/idLabels/${l.id}`)
    console.warn(`#${c.idShort} untagged ${name}: ${c.name}`)
  },
  /**
   * checklist <number> <title> <item>… — a plan's steps, or a year's sources, as a checklist on its card. A checklist
   * of that title already on the card is added to, never doubled: a year's sources arrive one by one (2026-10-22).
   */
  async checklist(number, title, ...items) {
    if (!title || items.length === 0) fail('checklist <number> <title> <item>…')
    const c = await card(number)
    const existing = (await api('GET', `/cards/${c.id}/checklists`)).find((l) => l.name === title)
    const list = existing ?? (await api('POST', `/cards/${c.id}/checklists`, { name: title }))
    for (const name of items) await api('POST', `/checklists/${list.id}/checkItems`, { name })
    console.warn(`#${c.idShort} checklist "${title}" ${existing ? 'extended' : 'created'}: ${items.length} items`)
  },
  /** check <number> <text> — ticks the one checklist item whose name contains the text. */
  async check(number, text) {
    if (!text) fail('check <number> <text>')
    const c = await card(number)
    const items = (await api('GET', `/cards/${c.id}/checklists`)).flatMap((l) => l.checkItems)
    const matches = items.filter((i) => i.name.includes(text))
    if (matches.length !== 1) fail(`${matches.length} items match "${text}" on #${c.idShort}: ${items.map((i) => i.name).join(' | ')}`)
    await api('PUT', `/cards/${c.id}/checkItem/${matches[0].id}`, { state: 'complete' })
    console.warn(`#${c.idShort} ticked: ${matches[0].name}`)
  },
  /**
   * attachments <number> [directory] — lists a card's attachments (the dev's screenshots, 2026-10-29); given a directory,
   * saves each file in it under its own name. Trello serves an upload only with the key and token in an OAuth header.
   */
  async attachments(number, directory) {
    const c = await card(number)
    const found = await api('GET', `/cards/${c.id}/attachments`, { fields: 'name,url,bytes,mimeType,isUpload' })
    if (found.length === 0) fail(`#${c.idShort} has no attachment`)
    const { mkdir, writeFile } = await import('node:fs/promises')
    if (directory) await mkdir(directory, { recursive: true })
    for (const a of found) {
      console.warn(`#${c.idShort} ${a.name} — ${a.mimeType ?? '?'}, ${Math.round((a.bytes ?? 0) / 1024)} kB, ${a.url}`)
      if (!directory || !a.isUpload) continue
      const response = await fetch(a.url, {
        headers: { Authorization: `OAuth oauth_consumer_key="${TRELLO_API_KEY}", oauth_token="${TRELLO_TOKEN}"` },
      })
      if (!response.ok) fail(`GET ${a.url} → ${response.status}`)
      const path = `${directory}/${a.name}`
      await writeFile(path, Buffer.from(await response.arrayBuffer()))
      console.warn(`  saved ${path}`)
    }
  },
  /** show <number> — title, column, description, checklists and comments. */
  async show(number) {
    const c = await card(number)
    const column = (await lists()).find((list) => list.id === c.idList)?.name ?? '(archived column)'
    console.warn(`#${c.idShort} ${c.name}\n${column} — ${c.url}\n${c.desc || '(no description)'}`)
    for (const list of await api('GET', `/cards/${c.id}/checklists`)) {
      console.warn(`  ☐ ${list.name}`)
      for (const i of list.checkItems) console.warn(`    ${i.state === 'complete' ? '✓' : '·'} ${i.name}`)
    }
    const comments = await api('GET', `/cards/${c.id}/actions`, { filter: 'commentCard' })
    for (const a of comments.reverse()) console.warn(`  ${a.date.slice(0, 10)} ${a.data.text}`)
  },
}

const [verb, ...args] = process.argv.slice(2)
if (!verb || !(verb in verbs)) fail(`verbs: ${Object.keys(verbs).join(', ')}`)
await verbs[verb](...args)
