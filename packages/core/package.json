{
  "name": "@europe-historical-atlas/core",
  "version": "1.0.0",
  "description": "Pure TypeScript core of the atlas: data ports, compositing pipeline, geo maths, utilities. No three.js.",
  "type": "module",
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-eha": "workspace:*",
    "vitest": "catalog:"
  }
}
