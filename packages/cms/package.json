{
  "name": "@europe-historical-atlas/cms",
  "version": "1.0.0",
  "description": "The CMS — the shared contribution system: places, events, people and sources, entered in Payload and exported for the atlas.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm migrate && NODE_OPTIONS=--no-deprecation next dev --port 3100 --hostname 127.0.0.1",
    "migrate": "NODE_OPTIONS=--no-deprecation payload run src/migrate/run.ts",
    "migrate:create": "NODE_OPTIONS=--no-deprecation payload run src/migrate/create.ts",
    "migrate:status": "NODE_OPTIONS=--no-deprecation payload migrate:status",
    "export": "NODE_OPTIONS=--no-deprecation payload run src/export/run.ts",
    "export:print": "NODE_OPTIONS=--no-deprecation payload run src/export/print.ts",
    "names:check": "NODE_OPTIONS=--no-deprecation payload run src/names/run.ts",
    "merge": "NODE_OPTIONS=--no-deprecation payload run src/merge/run.ts",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed": "pnpm migrate && NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "retitle": "NODE_OPTIONS=--no-deprecation payload run src/seed/retitle.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@europe-historical-atlas/core": "workspace:^",
    "@fubaritico/react": "catalog:",
    "@fubaritico/styles": "catalog:",
    "@fubaritico/tokens": "catalog:",
    "@payloadcms/db-sqlite": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/plugin-mcp": "3.92.0",
    "@payloadcms/translations": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "formik": "catalog:",
    "graphql": "^16.8.1",
    "next": "16.4.6",
    "payload": "3.92.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-eha": "workspace:*",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "sass": "1.77.4",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
