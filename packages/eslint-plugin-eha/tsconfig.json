{
  // The plugin is JavaScript typed with JSDoc, because ESLint imports it as it is: Node 22.14 could
  // not load a `.ts` file without a flag when it was written (type stripping is unflagged from 22.18; the repository
  // is on Node 24 since 2026-10-21, so that reason no longer holds), and a build step would put
  // a `dist/` between a rule and every lint that runs it. `checkJs` gives the JSDoc the same strictness as
  // the rest of the repository, and the typed lint reads the files through this config.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src"]
}
