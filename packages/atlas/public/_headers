# Netlify headers, carried INSIDE the published directory on purpose.
#
# The site is deployed with `netlify deploy --no-build` from a CI artefact, not built by Netlify.
# In that mode `netlify.toml` is resolved from whatever directory the CLI runs in, which is easy to
# get wrong and impossible to notice — a missing header is silent. `_headers` and `_redirects` live
# in the publish directory itself, so they travel with the artefact and always apply.

# Vite fingerprints what it emits: safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The physical payloads are NOT fingerprinted — their names are stable, so a regenerated DEM keeps
# the same URL. One day helps a returning reader without making a replaced asset invisible forever.
/heightmaps/*
  Cache-Control: public, max-age=86400
/masks/*
  Cache-Control: public, max-age=86400
/rivers/*
  Cache-Control: public, max-age=86400

# Security headers (REPO-275, the dev's call of 2026-10-23). The atlas loads nothing from another origin:
# its scripts, its worker and its data files are same-origin. Two exceptions, each for a reason:
# `style-src 'unsafe-inline'` — the page's own <style> block and the dev panel (lil-gui) injects its sheet;
# `img-src data:` — the compass rose, the title and the frame labels are SVG strings loaded as data URLs.
# A new origin (fonts, an event's image, a tile server) must be added here, or the browser refuses it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
