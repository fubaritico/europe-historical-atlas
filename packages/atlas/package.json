{
  "name": "@europe-historical-atlas/atlas",
  "version": "1.0.0",
  "description": "The 3D atlas: renderer, scene modules, camera, controls, DOM overlay, and the composition root.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@europe-historical-atlas/core": "workspace:^",
    "lil-gui": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@types/fontkit": "catalog:",
    "@types/three": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-eha": "workspace:*",
    "fontkit": "catalog:",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
